# Supabase Postgres connection string (Supabase Dashboard > Connect > Session pooler).
# Keep the password private. Use the connection string with sslmode=require.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Google Maps Platform (Maps JS & Places API).
# Restrict this key in Google Cloud Console to HTTP referrers and Maps JS / Places APIs.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_SUPABASE_URL & VITE_SUPABASE_PUBLISHABLE_KEY: Supabase project connection settings.
# Configure these in the Render service environment or your local .env file.
# Never place a Supabase service_role or secret key in any VITE_ variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

