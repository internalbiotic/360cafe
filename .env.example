# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Public browser key for Google Maps Platform (Maps JS & Places API).
# Restrict this key in Google Cloud Console to HTTP referrers and Maps JS / Places APIs.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_SUPABASE_URL & VITE_SUPABASE_PUBLISHABLE_KEY: Supabase project connection settings.
# Configure these in AI Studio Secrets or your local .env file.
# Never place a Supabase service_role or secret key in any VITE_ variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

